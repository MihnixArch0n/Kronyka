# ==============================================================================
# Kronyka Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Database Configuration
POSTGRES_DB=kronyka
POSTGRES_USER=kronyka
POSTGRES_PASSWORD=kronyka_secret
POSTGRES_PORT=5432

# Application Configuration
SERVER_PORT=8080
JWT_SECRET=kronyka-default-super-secret-hmac-sha256-key-32-chars-minimum!
JWT_EXPIRATION=86400

# Vickrey Settlement Scheduler
KRONYKA_AUCTION_SETTLEMENT_ENABLED=true
KRONYKA_AUCTION_SETTLEMENT_FIXED_DELAY_MS=5000
KRONYKA_AUCTION_SETTLEMENT_BATCH_SIZE=50
